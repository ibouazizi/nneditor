  "devices": ["cpu"],
  "python_modules": ["torch", "transformers", "safetensors"],
  "install_extra": "tracer-modalities",
  "description": "Trace a local LLaVA, Qwen2-VL, or Gemma 3 snapshot. Install nneditor[tracer-modalities]. Captures the vision tower, projector, decoder blocks, and logits."
}

{
  "api_version": 1,
  "id": "nneditor.bitnet",
  "name": "BitNet",
  "version": "1.0.0",
  "entry_point": "tracer.py:trace",
  "artifact_kinds": ["huggingface_model", "gguf_model"],
  "architectures": ["bitnet", "BitNetForCausalLM"],
  "element_types": ["float32", "float16", "bfloat16", "q4_0", "q4_1", "q4_k", "q8_0", "q8_1", "q8_k", "q5_k", "q6_k"],
  "devices": ["cpu"],
  "python_modules": ["torch", "transformers", "safetensors"],
  "install_extra": "tracer-modalities",
  "description": "Trace a local BitNet snapshot or a BitNet GGUF, including Q4 and Q8 weights. Install nneditor[tracer-modalities]. Captures each decoder block and the logits."
}
